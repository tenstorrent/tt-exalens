# Runs pipeline.py with the project's Python (3.10 or newer).
here=$(cd "$(dirname "$0")" && pwd)
for python in "$here/../../.venv/bin/python3" python3 python3.13 python3.12 python3.11 python3.10; do
    if command -v "$python" >/dev/null 2>&1 &&
        "$python" -c 'import sys; sys.exit(sys.version_info < (3, 10))' 2>/dev/null; then
        exec "$python" "$here/pipeline.py" "$@"
    fi
done
echo "issue pipeline: Python 3.10 or newer was not found" >&2
exit 1
