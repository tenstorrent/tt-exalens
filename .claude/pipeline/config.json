{
  "mode": "guided",
  "gates": {
    "issue": "auto",
    "plan": "auto",
    "result": "auto",
    "prompts": "user"
  },
  "home": ".issue-pipeline",
  "base_ref": "origin/main",
  "tt_metal": "",
  "branch_user": "",
  "branch_docs": "docs/agentic",
  "mirror_branch": true,
  "auto_stop_limit": 6,
  "pr_footer": "🤖 Generated with [Claude Code](https://claude.com/claude-code)",
  "caps": {
    "triage": 1,
    "shaper_questions": 2,
    "investigation": 2,
    "plan_revisions": 3,
    "test_retries": 3,
    "fixes": 3,
    "review": 1,
    "hw_runs": 4,
    "agent_calls": 80
  },
  "hardware": {
    "enabled": true,
    "ird_host": "yyz-ird",
    "min_minutes_left": 30,
    "remote_root": "/localdev/{user}/issue-pipeline",
    "build": "cmake -B build_debug -G Ninja -DCMAKE_BUILD_TYPE=Debug -DCMAKE_POLICY_VERSION_MINIMUM=3.5 && ninja -C build_debug",
    "build_timeout": 3600,
    "test_timeout": 1800,
    "nocs": [0, 1],
    "reset": "tt-smi -r",
    "docs_target": "wormhole",
    "docs_timeout": 1800,
    "quasar_hosts": "^tensix-l-\\d+$",
    "quasar_changes": "(?i)quasar|rocket",
    "quasar": {
      "simulators": "/localdev/{user}/work/tt-umd-simulators/build",
      "emulation": {"default": "emu-quasar-1x3", "rocket": "emu-grendel-quasar-t6x1_DM"},
      "simulation": {"default": "vcs-quasar-1x3", "rocket": "vcs-quasar-2x3_SMU"},
      "nocs": [0],
      "emulation_start_minutes": 15,
      "simulation_start_minutes": 30,
      "busy_wait_minutes": 10,
      "test_timeout": 3600
    }
  },
  "context": {
    "hard_cap": 500000,
    "stop_at": 450000,
    "wrap_at": 350000,
    "continue_under": 300000,
    "read_whole_max_bytes": 24000,
    "read_max_lines": 400,
    "diff_context_lines": 12,
    "max_calls": {
      "investigator": 50,
      "triager": 40,
      "planner": 80,
      "reviewer": 80,
      "test-writer": 200,
      "implementer": 250,
      "papa": 100
    }
  },
  "limits": {
    "issue_words": 250,
    "issue_criteria": 5,
    "criterion_words": 30,
    "issue_code_lines": 25,
    "design_words": 300,
    "design_code_lines": 40,
    "plan_words": 2500,
    "plan_code_lines": 150,
    "findings_words": 1200,
    "triage_words": 300,
    "report_words": 400,
    "pr_words": 200
  },
  "prices": {
    "_note": "USD per million tokens. A 5-minute cache write costs 1.25 x input, a 1-hour write 2 x input; fast mode doubles all",
    "claude-fable-5-2": {"input": 8.0, "output": 40.0, "cache_read": 0.2},
    "claude-opus-5-5": {"input": 4.0, "output": 20.0, "cache_read": 0.2},
    "claude-sonnet-5-5": {"input": 2.0, "output": 10.0, "cache_read": 0.1},
    "claude-haiku-5-5": {"input": 0.1, "output": 0.5, "cache_read": 0.01}
  },
  "device_free_tests": [
    "test.ttexalens.unit_tests.test_exception_hierarchy",
    "test.ttexalens.unit_tests.test_noc_failover",
    "test.ttexalens.unit_tests.test_search"
  ],
  "workspace_readable": [".claude", ".github", ".venv", "AGENTS.md"],
  "leak_patterns": [
    "\\[internal\\]",
    "atlassian\\.net",
    "slack\\.com",
    "sharepoint\\.com",
    "docs\\.google\\.com",
    "drive\\.google\\.com",
    "glean\\.com",
    "@tenstorrent\\.com"
  ]
}
